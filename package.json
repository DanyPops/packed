{
  "name": "@danypops/pi-packed",
  "version": "0.5.3",
  "description": "Package service for the Pi agent: search/info/install/updates + /packages TUI, backed by a long-running Bun service",
  "type": "module",
  "bin": {
    "packed": "src/cli.ts"
  },
  "keywords": [
    "pi-package"
  ],
  "scripts": {
    "test": "bun test",
    "typecheck": "bun x tsc --noEmit",
    "cli": "bun src/cli.ts",
    "serve": "bun src/cli.ts serve"
  },
  "pi": {
    "extensions": [
      "extension/src/index.ts"
    ]
  },
  "dependencies": {
    "@danypops/daemon-kit": "^0.4.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "bun-types": "latest"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DanyPops/pi-packed.git"
  },
  "files": [
    "src",
    "extension",
    "README.md"
  ]
}
