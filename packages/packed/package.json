{
  "name": "@danypops/packed",
  "version": "0.1.0",
  "description": "Standalone package lifecycle, validation, catalog, setup, and daemon service for Pi packages",
  "type": "module",
  "bin": {
    "packed": "src/cli.ts"
  },
  "scripts": {
    "build": "rm -rf dist && bun build src/public/client.ts src/public/protocol.ts --outdir dist --target node --format esm --minify && bunx tsc -p tsconfig.public.json",
    "test": "bun run build && bun test test",
    "typecheck": "bunx tsc --noEmit",
    "cli": "bun src/cli.ts",
    "serve": "bun src/cli.ts serve"
  },
  "dependencies": {
    "@danypops/daemon-kit": "^0.4.0",
    "jiti": "2.6.1",
    "publint": "0.3.22",
    "typebox": "^1.3.6"
  },
  "exports": {
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    },
    "./protocol": {
      "types": "./dist/protocol.d.ts",
      "import": "./dist/protocol.js"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DanyPops/pi-packed.git",
    "directory": "packages/packed"
  },
  "keywords": [
    "pi",
    "package-manager"
  ],
  "files": [
    "src",
    "dist",
    "schema",
    "README.md"
  ]
}
