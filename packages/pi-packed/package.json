{
  "name": "@danypops/pi-packed",
  "version": "0.28.9",
  "description": "Pi package lifecycle, validation, daemon, tools, profiles, and TUI",
  "type": "module",
  "bin": {
    "packed": "service/src/cli/cli.ts"
  },
  "keywords": ["pi-package"],
  "pi": {
    "extensions": ["extension/src/index.ts"]
  },
  "packed": {
    "daemonService": {
      "name": "pi-packed",
      "displayName": "Packed package service",
      "binPath": "service/src/cli/cli.ts",
      "args": ["serve"],
      "handleFilename": "handle.json",
      "restartOnFailure": true,
      "restartSec": 2
    }
  },
  "scripts": {
    "build": "rm -rf dist && bun build service/src/public/client.ts service/src/public/protocol.ts service/src/public/doctor-format.ts --outdir dist --target node --format esm --minify && bunx tsc -p service/tsconfig.public.json",
    "test": "bun run build && bun test service/test test",
    "typecheck": "bunx tsc --noEmit"
  },
  "dependencies": {
    "@danypops/armada": "^0.5.0",
    "@danypops/packed": "^0.7.0",
    "@danypops/pi-extension-harness": "^0.7.0",
    "@danypops/vehicle-client": "^0.10.5",
    "@danypops/vehicle-core": "^0.18.4",
    "@danypops/vehicle-server": "^0.26.0",
    "jiti": "^2.7.0",
    "malevich-tui-components": "^0.32.1",
    "publint": "0.3.22",
    "semver": "^7.8.5"
  },
  "devDependencies": {
    "@danypops/pi-tui-harness": "^0.0.1",
    "@danypops/vehicle-client-pi": "^0.45.0",
    "@danypops/vehicle-conformance": "^0.4.0",
    "@types/semver": "^7.7.1",
    "follow-redirects": "^1.16.0"
  },
  "peerDependencies": {
    "@danypops/vehicle-client-pi": "^0.45.0",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DanyPops/packed.git",
    "directory": "packages/pi-packed"
  },
  "exports": {
    "./client": {
      "types": "./dist/public/client.d.ts",
      "import": "./dist/client.js"
    },
    "./protocol": {
      "types": "./dist/public/protocol.d.ts",
      "import": "./dist/protocol.js"
    },
    "./doctor-format": {
      "types": "./dist/public/doctor-format.d.ts",
      "import": "./dist/doctor-format.js"
    }
  },
  "files": ["extension", "service", "dist", "README.md"]
}
